# TravelMind Environment Configuration
# Copy this file to .env and fill in with your actual values

# Application Environment
ENVIRONMENT=development
VERSION=dev
LOG_LEVEL=info

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Database Configuration
DATABASE_URL=postgres://travelmind:password@localhost:5432/travelmind?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFE=5

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRY=3600

# OAuth (optional)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# Claude AI Integration
CLAUDE_API_KEY=sk-ant-your-claude-api-key
CLAUDE_MODEL=claude-opus-4-1
CLAUDE_MAX_TOKENS=4096

# Google Cloud Platform
GCP_PROJECT_ID=your-gcp-project-id
FIRESTORE_COLLECTION=bookings
BIGQUERY_DATASET=analytics
PUBSUB_TOPIC=booking-events
STORAGE_BUCKET=travelmind-storage
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-credentials.json

# Payment Gateway (Stripe)
STRIPE_API_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Payment Gateway (Adyen)
ADYEN_API_KEY=your_adyen_api_key
ADYEN_MERCHANT_ACCOUNT=your_merchant_account

# Logging & Monitoring
DATADOG_API_KEY=
SENTRY_DSN=

# Supplier API Keys
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
BOOKING_COM_API_KEY=
EXPEDIA_API_KEY=

# Feature Flags
FEATURE_AI_AGENT_ENABLED=true
FEATURE_FRAUD_DETECTION_ENABLED=true
FEATURE_VOICE_BOOKING_ENABLED=false

# Cache Configuration
CACHE_TTL_RATES=900
CACHE_TTL_PREFERENCES=3600
CACHE_TTL_SUPPLIER_INVENTORY=300

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# Fraud Detection Thresholds
FRAUD_RISK_SCORE_THRESHOLD=70
FRAUD_VELOCITY_CHECK_ENABLED=true
FRAUD_DEVICE_FINGERPRINT_ENABLED=true

# Deployment
DOCKER_REGISTRY=gcr.io
DOCKER_REGISTRY_PROJECT=your-gcp-project-id
KUBERNETES_CLUSTER=us-central1-c
KUBERNETES_NAMESPACE=travelmind
